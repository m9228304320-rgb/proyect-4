      "north_america_usmca": {
        "status": "compliant",
        "applicable_law": "T-MEC / USMCA Chapter 19 (Digital Trade)",
        "required_registries": ["Cross-Border Data Transfer Logs", "Commercial Software Registry"]
      },
      "asia_pacific_cptpp": {
        "status": "compliant",
        "applicable_law": "CPTPP Chapter 14 (Electronic Commerce)",
        "required_registries": ["Source Code Protection Declarations"]
